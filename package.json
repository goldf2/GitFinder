{
  "name": "gitfinder-2",
  "version": "2.0.0-alpha.102",
  "description": "GitFinder 2 - 本地开发与部署管理中心",
  "main": "main.js",
  "productName": "GitFinder 2 Alpha",
  "bin": {
    "git-monitor": "./cli.js"
  },
  "scripts": {
    "test": "node --test",
    "build:renderer": "node scripts/build-renderer.js",
    "measure:whiteboard": "node scripts/measure-relationship-whiteboard.js",
    "check": "npm run build:renderer && npm test && node scripts/check-syntax.js",
    "start": "node server.js",
    "dev": "node server.js",
    "dev:panel-mock": "node scripts/mock-panel-server.js",
    "cli": "node cli.js",
    "scan": "node cli.js scan",
    "status": "node cli.js status",
    "verify:git-batch": "node scripts/verify-git-batch-performance.js",
    "verify:icons": "node scripts/verify-icon-assets.js",
    "verify:release-source": "node scripts/verify-release.js --phase source --mode development",
    "verify:release": "node scripts/verify-release.js --phase artifact --mode development --report dist/release-verification.json",
    "verify:windows-runtime": "electron scripts/verify-windows-runtime.js",
    "preelectron": "npm run build:renderer",
    "electron": "electron .",
    "pack": "bash scripts/build-mac.sh",
    "dist": "bash scripts/build-mac.sh",
    "pack:win": "node scripts/build-win.js",
    "release:describe": "node scripts/create-store-release.js",
    "release:push-draft": "node scripts/push-store-release.js"
  },
  "build": {
    "appId": "com.gitfinder.app.v2",
    "productName": "GitFinder 2 Alpha",
    "directories": {
      "output": "dist",
      "app": "."
    },
    "asar": true,
    "asarUnpack": [
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "files": [
      "main.js",
      "server.js",
      "cli.js",
      "preload.js",
      "public/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "GitFinder-2-${version}-${arch}-win.${ext}"
    },
    "nsis": {
      "artifactName": "GitFinder-2-${version}-${arch}-win-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitFinder 2 Alpha",
      "uninstallDisplayName": "GitFinder 2 Alpha ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "buffer-crc32": "1.0.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.2",
    "openid-client": "6.8.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2"
  },
  "keywords": [
    "git",
    "monitor",
    "status",
    "dashboard"
  ],
  "author": "goldf2",
  "license": "MIT"
}
